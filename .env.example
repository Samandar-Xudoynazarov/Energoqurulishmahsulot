# Admin panel paroli (/admin/login)
ADMIN_PASSWORD=

# Supabase (bepul) — rasmlar, PDF va sayt ma'lumotlari shu yerda saqlanadi.
# Supabase → Project Settings → API Keys:
#   SUPABASE_URL              = Project URL (https://xxxx.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY = "Secret key" (sb_secret_...) yoki eski "service_role" kalit
# Bu kalit maxfiy — faqat Vercel env'ga yozing, hech kimga bermang.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Ixtiyoriy: bucket nomi (standart "site"). Bucket avtomatik yaratiladi.
# SUPABASE_BUCKET=site

# Saytdagi so'rov formalari shu Telegram chatga keladi.
# 1) @BotFather'da /newbot → token oling
# 2) Botga /start yozing (yoki botni guruhga qo'shing)
# 3) https://api.telegram.org/bot<TOKEN>/getUpdates ochib "chat":{"id":...} ni oling
# Bir nechta qabul qiluvchi bo'lsa — vergul bilan: 123456789,-1001234567890
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
